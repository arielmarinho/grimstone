extends Object
## Icones de itens embutidos (base64) — gerados a partir da arte pixel real

const ICON_ARCO := ""
const ICON_CAJADO := ""
const ICON_CARNE := ""
const ICON_ESPADA := ""
const ICON_MACHADO := ""
const ICON_MOEDA := ""
const ICON_POCAO_MANA := ""
const ICON_POCAO_VIDA := ""

const NAMES := ["moeda","carne","pocao_vida","pocao_mana","espada","machado","arco","cajado"]

static func get_png_bytes(id: String) -> PackedByteArray:
	if not NAMES.has(id):
		return PackedByteArray()
	var b64: String = get("ICON_" + id.to_upper())
	return Marshalls.base64_to_raw(b64)
